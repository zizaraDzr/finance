SYNC_TOKEN=change-me
VITE_SYNC_TOKEN=change-me
PORT=4174
FINANCE_DATA_FILE=data/finance-data.json

# Бэкап на Яндекс Диск по REST API.
# OAuth-токен приложения с доступом к Диску (oauth.yandex.ru).
YANDEX_OAUTH_TOKEN=oauth-token
YANDEX_BACKUP_PATH=Documents/finance_backup
YANDEX_BACKUP_LIMIT=10

# TLS-сертификат для локального HTTPS (генерируется командой pnpm certs)
# TLS_KEY_PATH=selfsigned.key
# TLS_CERT_PATH=selfsigned.crt
